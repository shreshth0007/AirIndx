# ========================================================
# AirIndx Environmental Intelligence - Environment Config
# ========================================================

# 1. Frontend Backend Target Endpoint
VITE_BACKEND_API_URL=http://localhost:8000

# 2. Gemini AI Assistant (Client-Side & Server Insights)
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 3. SMS Gateway Configuration (Twilio / MSG91 / Sandbox)
# Options: "sandbox" (default dev simulator) | "twilio" | "msg91"
SMS_PROVIDER=sandbox

# A. Twilio SMS Configuration (Global)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# B. MSG91 SMS Configuration (India TRAI / DLT Registered)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=AIRIND
MSG91_TEMPLATE_ID=your_dlt_approved_template_id_here

# 4. AWS Amazon Bedrock Agent Runtime (Optional Enterprise Track)
AWS_REGION=us-east-1
AWS_BEDROCK_AGENT_ID=YOUR_BEDROCK_AGENT_ID
AWS_BEDROCK_AGENT_ALIAS_ID=TSTALIASID

# 5. Email & SMTP Configuration (Nodemailer / Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_NAME=AirIndx Environmental Intelligence
